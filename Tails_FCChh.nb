Cell[BoxData[
 RowBox[{"lista", "=", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"M", ",", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"rjmin", "=", 
         RowBox[{"NMinimize", "[", 
          RowBox[{
           RowBox[{"tot\[Chi]MODEL", "[", 
            RowBox[{"x", ",", "M"}], "]"}], ",", 
           RowBox[{"{", "x", "}"}], ",", 
           RowBox[{"Method", "\[Rule]", "\"\<DifferentialEvolution\>\""}]}], 
          "]"}]}], ";", 
        RowBox[{"x", "/.", 
         RowBox[{
          RowBox[{"NMinimize", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"tot\[Chi]MODEL", "[", 
                  RowBox[{"x", ",", "M"}], "]"}], "-", 
                 RowBox[{"rjmin", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], "-", "4"}], ")"}], "2"], 
              ",", 
              RowBox[{"x", ">", "0"}]}], "}"}], ",", 
            RowBox[{"{", "x", "}"}]}], "]"}], "[", 
          RowBox[{"[", "2", "]"}], "]"}]}]}], ")"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"M", ",", "500", ",", "15000", ",", "250"}], "}"}]}], 
   "]"}]}]], "Input",
