Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"tot\[Chi]LLflavour", "[", 
    RowBox[{"CLu_", ",", "CLd_", ",", "CLs_", ",", "CLc_", ",", "CLb_"}], 
    "]"}], ":=", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "2"}], " ", 
      RowBox[{"Log", "[", 
       RowBox[{"pois", "[", 
        RowBox[{
         RowBox[{"DATA", "[", 
          RowBox[{"[", "bin", "]"}], "]"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"NevsSIGNAL", "[", 
            RowBox[{"[", "bin", "]"}], "]"}], 
           RowBox[{"relLLflavour", "[", 
            RowBox[{
