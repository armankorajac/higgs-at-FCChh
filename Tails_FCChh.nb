Cell[BoxData["\<\"Mathematica package for MSTW/MMHT PDFs\\noriginally by \
Graeme Watt <Graeme.Watt(at)durham.ac.uk>.\\nFor information on usage, see \
?ReadPDFGrid and ?xf.\\nThe update for MMHT2014 PDFs simply amounts to a \
redefinition \\nof nhess in mstwpdf.m to reflect the increase in the number \
of\\neigenvector sets. Note that 90% confidence level eigenvectors are \\nnot \
provided for MMHT2014 PDFs.\"\>"], "Print",
 CellChangeTimes->{3.7013258809810543`*^9, 3.701326461923935*^9, 
  3.701334304241987*^9, 3.701336399096624*^9, 3.7013451233223267`*^9, 
  3.7019527158552437`*^9, 3.701970195141094*^9, 3.702047493658634*^9, 
