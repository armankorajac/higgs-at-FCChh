Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"tot\[Chi]EFT", "[", "CL_", "]"}], ":=", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "2"}], " ", 
      RowBox[{"Log", "[", 
       RowBox[{"pois", "[", 
        RowBox[{
         RowBox[{"DATA", "[", 
          RowBox[{"[", "bin", "]"}], "]"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"NevsSIGNAL", "[", 
            RowBox[{"[", "bin", "]"}], "]"}], 
           RowBox[{"relSINGLET", "[", 
            RowBox[{"CL", ",", 
             RowBox[{"masa", "[", 
              RowBox[{"[", "bin", "]"}], "]"}]}], "]"}]}], "+", " ", 
          RowBox[{"NevsBCKG", "[", 
           RowBox[{"[", "bin", "]"}], "]"}]}]}], "]"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"bin", ",", "1", ",", 
       RowBox[{"Length", "[", "bck", "]"}]}], "}"}]}], "]"}]}], 
  ";"}]], "Input",
