          RowBox[{"i", ",", "2"}], "]"}], "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
       RowBox[{"Length", "[", "\[Sigma]Vp", "]"}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"flog\[Sigma]Vp", "=", 
   RowBox[{"Interpolation", "[", "log\[Sigma]Vp", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f\[Sigma]Vp", "[", "mV_", "]"}], ":=", 
   RowBox[{"Exp", "[", 
    RowBox[{"flog\[Sigma]Vp", "[", "mV", "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
