  RowBox[{"log\[Sigma]Vp", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Sigma]Vp", "[", 
        RowBox[{"[", 
         RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", 
       RowBox[{"Log", "[", 
        RowBox[{"\[Sigma]Vp", "[", 
