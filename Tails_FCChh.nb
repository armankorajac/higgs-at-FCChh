  RowBox[{
   RowBox[{"funk\[Sigma]Vp", "[", 
    RowBox[{"mV_", ",", "\[Kappa]q_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"f\[Sigma]Vp", "[", "mV", "]"}], " ", 
    RowBox[{"\[Kappa]q", "^", "2"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"kappaq", "[", 
    RowBox[{"\[Sigma]_", ",", "mV_"}], "]"}], ":=", 
   RowBox[{"Sqrt", "[", 
